# =============================================================================
# Paloma — environment template (tracked; copy to `.env`)
# =============================================================================
#   cp .env.example .env
#
# Loaded by paloma.env.load_env() and *.from_env() helpers.
# Pipeline script / `python -m paloma` read all tunables from here.
# Optional CLI path flags override INPUT/OUTPUT only. Empty = code default / None.
#
# Types: bool true|false · int (0b…/0x… ok) · float · pair "x,y"
# Pipeline order: Cleaning → Image Subtraction
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Global I/O
# -----------------------------------------------------------------------------

# Input FITS directory (alphabetical sort defines the temporal axis)
PALOMA_INPUT_DIR=tests/data/cleaning/groundtruth/raw
# Default run output root
PALOMA_OUTPUT_DIR=results
# Structured-layout base directory (empty = use OUTPUT_DIR)
PALOMA_OUTPUT_BASE=
# Dehazer: write under sector/params folders when true
PALOMA_STRUCTURED_LAYOUT=false
# Cleaning output dir (empty = {OUTPUT_DIR}/cleaned)
PALOMA_CLEANED_DIR=
# Image-subtraction output dir (empty = {OUTPUT_DIR}/subtracted)
PALOMA_SUBTRACTED_DIR=


# -----------------------------------------------------------------------------
# 2. Cleaning stage  →  CleaningConfig / DehazeConfig
# -----------------------------------------------------------------------------

# Registered cleaner name (built-in: dehazer)
PALOMA_CLEANER=dehazer
# Internal dehazer strategy label
PALOMA_DEHAZE_STRATEGY=default

# --- 2.1 Load / crop ---
# Max frames to load
PALOMA_DEHAZE_NUM_FRAMES=10
# Frames per batch (empty = all at once)
PALOMA_DEHAZE_BATCH_SIZE=
# Science HDU index
PALOMA_DEHAZE_FITS_EXTENSION=1
# Rows trimmed from bottom
PALOMA_DEHAZE_CROP_BOTTOM=30
# Columns trimmed from each side
PALOMA_DEHAZE_CROP_SIDES=44

# --- 2.2 Patches / airlight ---
# Square patch side length (px)
PALOMA_DEHAZE_PATCH_SIZE=9
# Minimum patch variance to keep (strict >)
PALOMA_DEHAZE_VARIANCE_THRESHOLD=5e-5
# Max nearest-neighbour pair distance (L2)
PALOMA_DEHAZE_NN_DIST_THRESHOLD=0.3
# Cap on patches per frame (empty = unlimited; subsample is unseeded)
PALOMA_DEHAZE_MAX_PATCHES=
# Airlight re-weighting iterations
PALOMA_DEHAZE_NUM_ITERATIONS=10

# --- 2.3 Transmission / recovery ---
# Temporal Gaussian sigma in frames (smooths A and t)
PALOMA_DEHAZE_SIGMA_TEMPORAL=1.5
# Lower clamp on transmission t
PALOMA_DEHAZE_T_MIN_CLIP=0.01
# Guided-filter radius (px)
PALOMA_DEHAZE_GUIDED_FILTER_RADIUS=60
# Guided-filter regularization epsilon
PALOMA_DEHAZE_GUIDED_FILTER_EPS=0.001

# --- 2.4 Runtime ---
# CuPy GPU opt-in (false = CPU reference path)
PALOMA_DEHAZE_USE_GPU=false


# -----------------------------------------------------------------------------
# 3. Image subtraction stage  →  ImageSubtractionConfig / SubtractionConfig
#    Runs AFTER cleaning. Not a Cleaner.
# -----------------------------------------------------------------------------

# Registered subtractor name (built-in: default / OIS)
PALOMA_SUBTRACTOR=default

# --- 3.1 Preprocess / cutout ---
# Frame cap (empty = all frames in input dir)
PALOMA_SUBTRACTION_NUM_FRAMES=
# Science HDU index
PALOMA_SUBTRACTION_FITS_EXTENSION=1
# Cutout center x,y
PALOMA_SUBTRACTION_CUTOUT_CENTER=1068,1024
# Cutout width,height (px)
PALOMA_SUBTRACTION_CUTOUT_SIZE=2048,2048
# WCS CRPIX1 for align / cutout
PALOMA_SUBTRACTION_CRPIX1=1001.0
# Skip frames that fail the DQUALITY bitmask
# (many TESS FFIs used for dehaze demos carry DQUALITY=128; set false for those)
PALOMA_SUBTRACTION_APPLY_DATA_QUALITY_FILTER=false
# TESS DQUALITY bitmask
PALOMA_SUBTRACTION_DATA_QUALITY_MASK=0b110010111101

# --- 3.2 OIS kernel ---
# Kernel half-width → size (2k+1)²
PALOMA_SUBTRACTION_KERNEL=2
# Stamp half-width → size (2s+1)²
PALOMA_SUBTRACTION_STAMP=3
# Spatial polynomial degree (0 = constant kernel)
PALOMA_SUBTRACTION_ORDER=0
# Max stars used for kernel fitting
PALOMA_SUBTRACTION_NR_STARS=500
# Spatial blocks (tiling)
PALOMA_SUBTRACTION_BLKNUM=50
# OIS / background refinement passes
PALOMA_SUBTRACTION_NUM_ITERATIONS=2
# RNG seed for kernel-star selection
PALOMA_SUBTRACTION_RANDOM_SEED=0

# --- 3.3 Detection / photometry ---
# Source-detection threshold
PALOMA_SUBTRACTION_THRESHOLD_SOURCE_DETECTION=50.0
# Assumed FWHM (px)
PALOMA_SUBTRACTION_FWHM=1.5
# Border excluded from detection (px)
PALOMA_SUBTRACTION_EDGE_CUTOFF=3
# Cross-match radius (px)
PALOMA_SUBTRACTION_MATCH_RADIUS=3
# Photometry aperture radius (px)
PALOMA_SUBTRACTION_APERTURE_RAD=3
# Post-detection source flux / significance cut
PALOMA_SUBTRACTION_SOURCE_FILTER_THRESHOLD=1.5

# --- 3.4 Backend ---
# true = compiled C a.out; false = pure-Python OIS
PALOMA_SUBTRACTION_USE_C_BACKEND=true
# C backend working directory (repo-relative)
PALOMA_SUBTRACTION_CODE_DIR=build/code_dir
