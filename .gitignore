# Keep regression fixtures in git (individual files are under 100MB)
!tests/data/cleaning/groundtruth/raw/*.fits
!tests/data/cleaning/groundtruth/expected/*.fits
!tests/data/image_subtraction/groundtruth/expected/residuals/*.fits

# Local capture scratch from ground-truth generation (not fixtures)
tests/data/**/_work/
tests/data/**/_paloma_capture/
_gt_work/

# Transient run outputs
results/*/
!results/README.md
!results/.gitkeep

# Local C-backend scratch (keep binary under build/; fits are runtime junk)
build/code_dir/*.fits
build/code_dir/*.txt
